# Local run (Windows/macOS/Linux)
# 1) Create venv:
#    python -m venv .venv
# 2) Activate it:
#    - Windows (PowerShell): .\\.venv\\Scripts\\Activate.ps1
#    - macOS/Linux: source .venv/bin/activate
# 3) Install deps:
#    pip install -r requirements.txt
# 4) If you have a SQLite DB (this repo includes data/book_reviews.db), export it to CSV:
#    python scripts/export_sqlite_to_csv.py --db data/book_reviews.db
# 5) Start the app:
#    python app.py

.venv/
venv/
